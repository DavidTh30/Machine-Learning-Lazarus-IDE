            Left = 90
            Height = 23
            Top = 8
            Width = 240
            ItemHeight = 15
            ItemIndex = 0
            Items.Strings = (
              'MLP neural network'
              'k-Nearest Neighbors (k-NN)'
              'Nearest centroid'
              'Ensemble vote (all classifiers)'
              'Compare all methods'
            )
            Style = csDropDownList
            TabOrder = 0
            Text = 'MLP neural network'
          end
          object lblK: TLabel
            Left = 8
            Height = 15
            Top = 42
            Width = 80
            Caption = 'k (for k-NN):'
          end
          object seK: TSpinEdit
            Left = 90
            Height = 23
            Top = 38
            Width = 70
            MaxValue = 25
            MinValue = 1
            TabOrder = 1
            Value = 3
          end
