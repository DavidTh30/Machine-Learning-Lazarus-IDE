      object tsSettings: TTabSheet
        Caption = 'Settings'
        ClientHeight = 570
        ClientWidth = 397
        object chkAutoThreshold: TCheckBox
          Left = 8
          Height = 19
          Top = 10
          Width = 380
          Caption = 'Automatic black/white threshold (Otsu)'
          Checked = True
          OnChange = SettingsChange
          State = cbChecked
          TabOrder = 0
        end
        object lblThreshold: TLabel
          Left = 8
          Height = 15
          Top = 38
          Width = 380
          Caption = 'Threshold: 128'
        end
        object tbThreshold: TTrackBar
          Left = 8
          Height = 30
          Top = 56
          Width = 381
          Frequency = 16
          Max = 255
          OnChange = SettingsChange
          Position = 128
          Anchors = [akTop, akLeft, akRight]
          Enabled = False
          TabOrder = 1
        end
        object lblPolarity: TLabel
          Left = 8
          Height = 15
          Top = 100
          Width = 100
          Caption = 'Text color:'
        end
        object cbPolarity: TComboBox
          Left = 120
          Height = 23
          Top = 96
          Width = 220
          ItemHeight = 15
          ItemIndex = 0
          Items.Strings = (
            'Automatic'
            'Dark text on light background'
            'Light text on dark background'
          )
          OnChange = SettingsChange
          Style = csDropDownList
          TabOrder = 2
          Text = 'Automatic'
        end
        object chkMergeParts: TCheckBox
          Left = 8
          Height = 19
          Top = 130
          Width = 380
          Caption = 'Merge vertically stacked parts (dot of i/j, accents)'
          Checked = True
          OnChange = SettingsChange
          State = cbChecked
          TabOrder = 3
        end
        object chkThaiMarks: TCheckBox
          Left = 8
          Height = 19
          Hint = 'Thai text: upper/lower vowels and tone marks are learned and read as their own symbols'
          Top = 152
          Width = 380
          Caption = 'Thai mode: vowels and tone marks are separate symbols'
          Font.Style = [fsBold]
          OnChange = SettingsChange
          ParentFont = False
          ParentShowHint = False
          ShowHint = True
          TabOrder = 8
        end
        object lblMinArea: TLabel
          Left = 8
          Height = 15
          Top = 186
          Width = 220
          Caption = 'Ignore specks smaller than (pixels):'
        end
        object seMinArea: TSpinEdit
          Left = 260
          Height = 23
          Top = 182
          Width = 80
          MaxValue = 10000
          MinValue = 1
          OnChange = SettingsChange
          TabOrder = 4
          Value = 4
        end
        object lblSpace: TLabel
          Left = 8
          Height = 15
          Top = 218
          Width = 240
          Caption = 'Max word space (x line height):'
        end
        object seSpace: TFloatSpinEdit
          Left = 260
          Height = 23
          Top = 214
          Width = 80
          DecimalPlaces = 2
          Increment = 0.05
          MaxValue = 5
          MinValue = 0.05
          TabOrder = 5
          Value = 0.4
        end
        object chkShowBinary: TCheckBox
          Left = 8
          Height = 19
          Top = 252
          Width = 380
          Caption = 'Show the black && white image used for processing'
          OnChange = SettingsChange
          TabOrder = 6
        end
        object chkShowBoxes: TCheckBox
          Left = 8
          Height = 19
          Top = 278
          Width = 380
          Caption = 'Show boxes and labels on the image'
          Checked = True
          OnChange = chkShowBoxesChange
          State = cbChecked
          TabOrder = 7
        end
      end
    end
