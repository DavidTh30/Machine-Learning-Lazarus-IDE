      ActivePage = tsLearn
      Align = alClient
      TabIndex = 0
      TabOrder = 0
      object tsLearn: TTabSheet
        Caption = 'Learn'
        ClientHeight = 570
        ClientWidth = 397
        object lblLabels: TLabel
          Left = 8
          Height = 15
          Top = 8
          Width = 380
          Caption = 'Label / text in the image (in order: left to right, top to bottom):'
        end
        object memoLabels: TMemo
          Left = 8
          Height = 70
          Top = 26
          Width = 381
          Anchors = [akTop, akLeft, akRight]
          Font.Height = -18
          OnChange = memoLabelsChange
          ParentFont = False
          ScrollBars = ssAutoVertical
          TabOrder = 0
        end
        object chkSplitSpace: TCheckBox
          Left = 8
          Height = 19
          Top = 100
          Width = 380
          Caption = 'Labels are separated by spaces (multi-character labels)'
          OnChange = memoLabelsChange
          TabOrder = 1
        end
        object chkWholeImage: TCheckBox
          Left = 8
          Height = 19
          Hint = 'Learn the whole image as a single item, e.g. a whole word or a multi-stroke character'
          Top = 122
          Width = 380
          Caption = 'Whole image is ONE symbol (a character or a whole word)'
          OnChange = SettingsChange
          ParentShowHint = False
          ShowHint = True
          TabOrder = 2
        end
        object btnSegment: TButton
          Left = 8
          Height = 30
          Top = 148
          Width = 186
          Caption = 'Segment symbols'
          OnClick = btnSegmentClick
          TabOrder = 3
        end
        object btnAddSamples: TButton
          Left = 200
          Height = 30
          Top = 148
          Width = 189
          Anchors = [akTop, akLeft, akRight]
          Caption = 'Add as training samples'
          OnClick = btnAddSamplesClick
          TabOrder = 4
        end
        object btnBatchLearn: TButton
          Left = 8
          Height = 30
          Hint = 'Select many images that all show the SAME character or word (the label typed above)'
          Top = 182
          Width = 381
          Anchors = [akTop, akLeft, akRight]
          Caption = 'Learn from multiple images (same label)...'
          Font.Style = [fsBold]
          OnClick = btnBatchLearnClick
          ParentFont = False
          ParentShowHint = False
          ShowHint = True
          TabOrder = 5
        end
        object lblMatch: TLabel
          Left = 8
          Height = 15
          Top = 218
          Width = 380
          Caption = '-'
          ParentFont = False
        end
        object gbTrain: TGroupBox
          Left = 8
          Height = 150
          Top = 240
          Width = 381
          Anchors = [akTop, akLeft, akRight]
          Caption = 'Train the neural network (MLP)'
          ClientHeight = 130
          ClientWidth = 377
          TabOrder = 6
          object lblEpochs: TLabel
            Left = 8
            Height = 15
            Top = 8
            Width = 60
            Caption = 'Epochs:'
          end
          object seEpochs: TSpinEdit
            Left = 80
            Height = 23
            Top = 4
            Width = 80
            MaxValue = 100000
            MinValue = 1
            TabOrder = 0
            Value = 300
          end
          object lblHidden: TLabel
            Left = 176
            Height = 15
            Top = 8
            Width = 95
            Caption = 'Hidden neurons:'
          end
          object seHidden: TSpinEdit
            Left = 280
            Height = 23
            Top = 4
            Width = 80
            MaxValue = 1024
            MinValue = 4
            TabOrder = 1
            Value = 96
          end
          object lblLR: TLabel
            Left = 8
            Height = 15
            Top = 38
            Width = 70
            Caption = 'Learn rate:'
          end
          object seLR: TFloatSpinEdit
            Left = 80
            Height = 23
            Top = 34
            Width = 80
            DecimalPlaces = 3
            Increment = 0.01
            MaxValue = 1
            MinValue = 0.001
            TabOrder = 2
            Value = 0.05
          end
          object chkAugment: TCheckBox
            Left = 8
            Height = 19
            Top = 64
            Width = 360
            Caption = 'Augmentation (randomly shift samples by 1 cell)'
            Checked = True
            State = cbChecked
            TabOrder = 3
          end
          object btnTrain: TButton
            Left = 8
            Height = 30
            Top = 92
            Width = 186
            Caption = 'Start training'
            Font.Style = [fsBold]
