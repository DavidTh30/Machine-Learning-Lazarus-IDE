            ParentFont = False
            TabOrder = 4
          end
          object btnStop: TButton
            Left = 200
            Height = 30
            Top = 92
            Width = 90
            Caption = 'Stop'
            Enabled = False
            OnClick = btnStopClick
            TabOrder = 5
          end
        end
        object pbTrain: TProgressBar
          Left = 8
          Height = 16
          Top = 396
          Width = 381
          Anchors = [akTop, akLeft, akRight]
          TabOrder = 7
        end
        object lblTrain: TLabel
          Left = 8
          Height = 15
          Top = 416
          Width = 380
          Caption = 'Not trained'
        end
      end
      object tsRead: TTabSheet
        Caption = 'Read'
        ClientHeight = 570
        ClientWidth = 397
        object pnlReadTop: TPanel
          Left = 0
          Height = 196
